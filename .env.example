# Copy to .env.local (git-ignored) and adjust.
# The local backend from `make up` in the project root. Android reaches it through
# `adb reverse tcp:8000 tcp:8000`, which `npm run android` sets up, so localhost works on both.
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Push notifications — empty in the template. See docs/push-notifications.md.
# The project's id at expo.dev (`eas init` prints it); without it the app cannot get a push token.
EAS_PROJECT_ID=
# The Expo account or organization that owns the project.
EXPO_OWNER=
