# Copy to .env.local (git-ignored) and adjust.

# Which of the three apps this machine builds: development | preview | production
# (docs/builds.md). Local work is the development app; EAS build profiles set their own.
APP_VARIANT=development

# The local backend from `make up` in the project root. Android reaches it through
# `adb reverse tcp:8000 tcp:8000`, which `npm run android` sets up, so localhost works on both.
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Push notifications — empty in the template. See docs/push-notifications.md.
# The project's id at expo.dev (`eas init` prints it); without it the app cannot get a push token.
EAS_PROJECT_ID=
# The Expo account or organization that owns the project.
EXPO_OWNER=

# Sentry (crash and error reports) — empty in the template, so nothing is sent. See docs/sentry.md.
# The DSN is public by design (it only lets the app send events), so it may be EXPO_PUBLIC_.
EXPO_PUBLIC_SENTRY_DSN=
# Where release builds upload source maps. SENTRY_AUTH_TOKEN never goes here or in any
# committed file — it is an EAS secret, or exported in the shell for a local release build.
SENTRY_ORG=
SENTRY_PROJECT=

# Sign in with Google / Apple — empty in the template: the buttons are hidden and signing in with
# an emailed code works on its own. See docs/sign-in.md. Client ids are not secrets.
# The web client (Google puts it in the ID token's `aud`; the backend checks it).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# The iOS client of THIS variant's bundle id (com.example.customers.dev locally).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# `true` once the App ID has the Sign in with Apple capability.
EXPO_PUBLIC_APPLE_SIGN_IN=

# The privacy policy linked from Settings (one page; it may switch language itself).
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
